@csrf_exempt
@require_POST
def webhook(request):
    try:
        data = json.loads(request.body.decode('utf-8'))
        logger.info(f"📨 Получен вебхук")
        
        token = settings.TELEGRAM_BOT_TOKEN
        if not token:
            return JsonResponse({'error': 'No token'}, status=400)
        
        if 'message' in data:
            message = data['message']
            chat_id = message['chat']['id']
            
            # Обработка контакта
            if 'contact' in message:
                contact = message['contact']
                phone = contact.get('phone_number', '')
                first_name = contact.get('first_name', '')
                last_name = contact.get('last_name', '')
                telegram_id = str(chat_id)
                
                user = User.objects.first()
                
                client, created = Client.objects.get_or_create(
                    phone=phone,
                    defaults={
                        'first_name': first_name,
                        'last_name': last_name or '',
                        'telegram_id': telegram_id,
                        'user': user,
                        'status': 'lead'
                    }
                )
                
                if not created:
                    client.first_name = first_name
                    client.last_name = last_name or client.last_name
                    client.telegram_id = telegram_id
                    client.save()
                    logger.info(f"🔄 Обновлен клиент: {client.first_name} {client.last_name}")
                
                avatar_saved = False
                if 'user_id' in contact:
                    contact_user_id = contact['user_id']
                    avatar_url = f'https://api.telegram.org/bot{token}/getUserProfilePhotos?user_id={contact_user_id}&limit=1'
                    avatar_response = requests.get(avatar_url).json()
                    
                    if avatar_response.get('ok') and avatar_response.get('result', {}).get('total_count', 0) > 0:
                        photos = avatar_response['result']['photos']
                        if photos and len(photos) > 0:
                            photo = photos[0][-1]
                            file_id = photo['file_id']
                            avatar_saved = True
                            process_avatar.delay(client.id, file_id, token)
                            logger.info(f"📷 Аватарка из контакта отправлена на обработку для {client.first_name}")
                
                if created:
                    response_text = f"✅ Клиент добавлен!\n\n👤 {client.first_name} {client.last_name}\n📞 {client.phone}"
                    if avatar_saved:
                        response_text += "\n🖼️ Аватарка из контакта загружается..."
                else:
                    response_text = f"ℹ️ Клиент уже существует, данные обновлены:\n\n👤 {client.first_name} {client.last_name}\n📞 {client.phone}"
                    if avatar_saved:
                        response_text += "\n🖼️ Аватарка из контакта обновлена..."
                
                url = f'https://api.telegram.org/bot{token}/sendMessage'
                requests.post(url, json={'chat_id': chat_id, 'text': response_text})
                return JsonResponse({'status': 'ok'})
            
            # Обработка фото
            if 'photo' in message:
                logger.info(f"📷 Получено фото от {chat_id}")
                
                if chat_id in avatar_states:
                    client_id = avatar_states[chat_id]
