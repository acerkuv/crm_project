def format_time_in_db(days):
    if days < 1:
        return "меньше дня"
    elif days == 1:
        return "1 день"
    elif days < 7:
        return f"{days} дня"
    elif days < 30:
        weeks = days // 7
        return f"{weeks} {'неделю' if weeks == 1 else 'недели' if weeks < 5 else 'недель'}"
    elif days < 365:
        months = days // 30
        return f"{months} {'месяц' if months == 1 else 'месяца' if months < 5 else 'месяцев'}"
    else:
        years = days // 365
        return f"{years} {'год' if years == 1 else 'года' if years < 5 else 'лет'}"


def get_clients_list(chat_id):
    state = list_states.get(chat_id, {'sort': 'created_at', 'order': 'desc'})
    sort_field = state.get('sort', 'created_at')
    order = state.get('order', 'desc')
    
    sort_mapping = {
        'created_at': 'created_at',
        'first_name': 'first_name',
        'last_name': 'last_name',
        'phone': 'phone'
    }
    sort_by = sort_mapping.get(sort_field, 'created_at')
    
    if order == 'desc':
        sort_by = f'-{sort_by}'
    
    all_clients = Client.objects.all().order_by(sort_by)
    total = all_clients.count()
    
    if total == 0:
        return "📭 Клиентов пока нет.\n\nДобавьте клиента через /add"
    
    response_text = f"📋 *Список клиентов* (всего {total})\n\n"
    response_text += f"🔄 Сортировка: {get_sort_label(sort_field, order)}\n\n"
    
    for i, client in enumerate(all_clients, 1):
        status_emoji = {'vip': '⭐', 'active': '✅', 'regular': '🔄', 'lead': '🆕', 'inactive': '⏸️'}.get(client.status, '📌')
        response_text += f"{i}. {status_emoji} *{client.first_name} {client.last_name}*\n"
        response_text += f"   📞 {client.phone}\n"
        if client.company:
            response_text += f"   🏢 {client.company}\n"
        if client.email:
            response_text += f"   ✉️ {client.email}\n"
        if client.comment:
            response_text += f"   📝 {client.comment[:60]}...\n" if len(client.comment) > 60 else f"   📝 {client.comment}\n"
        if client.avatar:
            response_text += f"   🖼️ Есть аватарка\n"
        
        days_in_db = (timezone.now() - client.created_at).days
        response_text += f"   📅 В базе: {format_time_in_db(days_in_db)}\n"
        response_text += "\n"
    
    return response_text


def get_sort_label(field, order):
    labels = {
        'created_at': 'по дате добавления',
        'first_name': 'по имени',
        'last_name': 'по фамилии',
        'phone': 'по телефону'
    }
    label = labels.get(field, 'по дате добавления')
    direction = '⬇️ (новые/по возрастанию)' if order == 'desc' else '⬆️ (старые/по убыванию)'
    return f"{label} {direction}"


def send_client_card(chat_id, client, token):
    """Отправка карточки клиента с мини-аватаркой (70x70)"""
    text = f"👤 *{client.first_name} {client.last_name}*\n\n"
    text += f"📞 {client.phone}\n"
    if client.company:
        text += f"🏢 {client.company}\n"
    if client.email:
        text += f"✉️ {client.email}\n"
    if client.comment:
        text += f"📝 {client.comment[:100]}...\n"
    if client.birth_date:
        text += f"🎂 {client.birth_date.strftime('%d.%m.%Y')}\n"
    text += f"📅 В базе: {format_time_in_db((timezone.now() - client.created_at).days)}"
    
    if client.avatar and client.avatar.name:
        try:
            avatar_url = f"{NGROK_URL}{client.avatar.url}"
            photo_url = f'https://api.telegram.org/bot{token}/sendPhoto'
            response = requests.post(photo_url, json={
                'chat_id': chat_id,
                'photo': avatar_url,
                'caption': text,
                'parse_mode': 'Markdown',
                'width': 70,
                'height': 70
            })
            if response.status_code == 200:
                logger.info(f"🖼️ Мини-аватарка (70x70) отправлена для {client.first_name}")
                return
            else:
                logger.error(f"❌ Ошибка отправки фото: {response.text}")
        except Exception as e:
            logger.error(f"❌ Ошибка отправки фото: {e}")
    
    url = f'https://api.telegram.org/bot{token}/sendMessage'
    requests.post(url, json={
        'chat_id': chat_id,
        'text': text,
        'parse_mode': 'Markdown'
    })


